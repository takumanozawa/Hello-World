# Database
DATABASE_URL=postgresql+asyncpg://ict_user:ict_password_2026@localhost:5432/ict_construction

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3互換ストレージ)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=ict-construction

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (オプション)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ict-construction.com

# LINE Messaging API (オプション)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# 外部API
WEATHER_API_KEY=your-openweathermap-api-key

# アプリケーション設定
APP_NAME=ICT施工Stage2管理システム
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# GPS設定
GPS_UPDATE_INTERVAL_SECONDS=10
GPS_ACCURACY_THRESHOLD_METERS=50

# サイクルタイム設定
CYCLE_LOADING_DWELL_SECONDS=180
CYCLE_UNLOADING_DWELL_SECONDS=120
CYCLE_MAX_WAITING_SECONDS=1800

# アラート設定
ALERT_SPEED_LIMIT_KMH=60
ALERT_DWELL_THRESHOLD_MINUTES=30
ALERT_SCHEDULE_DELAY_DAYS=3
